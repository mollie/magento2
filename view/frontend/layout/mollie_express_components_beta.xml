<!--
    Placements that need the shipping options beta of Mollie. Added by
    Mollie\Payment\Observer\LayoutLoadBefore\AddExpressComponentsLayoutHandle when the beta is enabled.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.addtocart">
            <block template="Mollie_Payment::product/view/express-components.phtml"
                   name="mollie.express.components.product"/>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional">
            <block template="Mollie_Payment::product/view/express-components.phtml"
                   name="mollie.express.components.product.additional"/>
        </referenceBlock>
        <referenceBlock name="checkout.root">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="checkout" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="steps" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="shipping-step" xsi:type="array">
                                            <item name="children" xsi:type="array">
                                                <item name="shippingAddress" xsi:type="array">
                                                    <item name="children" xsi:type="array">
                                                        <item name="before-form" xsi:type="array">
                                                            <item name="children" xsi:type="array">
                                                                <item name="mollie_express_components" xsi:type="array">
                                                                    <item name="component" xsi:type="string">Mollie_Payment/js/view/payment/express-components</item>
                                                                    <item name="config" xsi:type="array">
                                                                        <item name="template" xsi:type="string">Mollie_Payment/payment/express-components</item>
                                                                        <item name="placement" xsi:type="string">shipping</item>
                                                                        <item name="elementId" xsi:type="string">express-component-shipping</item>
                                                                    </item>
                                                                </item>
                                                            </item>
                                                        </item>
                                                    </item>
                                                </item>
                                            </item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="header-wrapper">
            <referenceBlock name="minicart">
                <arguments>
                    <argument name="jsLayout" xsi:type="array">
                        <item name="components" xsi:type="array">
                            <item name="minicart_content" xsi:type="array">
                                <item name="children" xsi:type="array">
                                    <item name="mollie_express_components" xsi:type="array">
                                        <item name="config" xsi:type="array">
                                            <item name="isBetaEnabled" xsi:type="boolean">true</item>
                                        </item>
                                    </item>
                                </item>
                            </item>
                        </item>
                    </argument>
                </arguments>
            </referenceBlock>
        </referenceContainer>
    </body>
</page>
